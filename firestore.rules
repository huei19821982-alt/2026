rules_version = '2';

// 중등교육과 자료 취합 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여 넣고 [게시]를 누르세요.
//
// 접속 코드와 관리자 코드는 config/secret 문서에 저장해요. (콘솔에서 직접 만들어요)
//   config/secret = { code: "과 접속 코드", adminCode: "관리자 코드" }
// 이 문서는 웹페이지에서 절대 읽을 수 없어요. 규칙만 비교에 사용해요.

service cloud.firestore {
  match /databases/{database}/documents {

    function secret()   { return get(/databases/$(database)/documents/config/secret).data; }
    function signedIn() { return request.auth != null; }
    function myDoc()    { return /databases/$(database)/documents/members/$(request.auth.uid); }
    // 접속 코드를 맞게 입력한 사람 (코드를 바꾸면 기존 접속이 모두 끊겨요)
    function isMember() { return signedIn() && exists(myDoc()) && get(myDoc()).data.code == secret().code; }
    // 관리자 코드까지 맞게 입력한 사람
    function isAdmin()  { return isMember() && get(myDoc()).data.get('adminCode', '') == secret().adminCode; }

    // 접속 코드 보관함: 아무도 읽거나 쓸 수 없음 (콘솔에서만 수정)
    match /config/{doc} {
      allow read, write: if false;
    }

    // 접속 기록: 코드가 맞을 때만 자기 기록을 만들 수 있음
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.code == secret().code
        && (!('adminCode' in request.resource.data) || request.resource.data.adminCode == secret().adminCode);
      allow delete: if false;
    }

    // 직원 명단
    match /staff/{doc} {
      allow read, write: if isMember();
    }

    // 취합 건 (+ 양식 파일 조각)
    match /reqs/{rid} {
      allow read, create, update: if isMember();
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
      match /chunks/{chunk} {
        allow read, write: if isMember();
      }
    }

    // 제출물: 모두 읽을 수 있고, 쓰기는 본인(또는 관리자)만
    match /subs/{uid} {
      allow read: if isMember();
      allow write: if isMember() && (request.auth.uid == uid || isAdmin());
      match /chunks/{chunk} {
        allow read: if isMember();
        allow write: if isMember() && (request.auth.uid == uid || isAdmin());
      }
    }
  }
}
